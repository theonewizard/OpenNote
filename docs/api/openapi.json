{
  "components": {
    "schemas": {
      "ProbeStatus": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ProbeStatus",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ServerMeta": {
        "properties": {
          "api_versions": {
            "items": {
              "type": "string"
            },
            "title": "Api Versions",
            "type": "array"
          },
          "login_methods": {
            "items": {
              "type": "string"
            },
            "title": "Login Methods",
            "type": "array"
          },
          "server_version": {
            "title": "Server Version",
            "type": "string"
          },
          "sync_protocol_versions": {
            "items": {
              "type": "integer"
            },
            "title": "Sync Protocol Versions",
            "type": "array"
          }
        },
        "required": [
          "server_version",
          "api_versions",
          "sync_protocol_versions",
          "login_methods"
        ],
        "title": "ServerMeta",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "OpenNote API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/meta": {
      "get": {
        "description": "The server version, the API and sync protocol versions, and the login methods.",
        "operationId": "get_meta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerMeta"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Get Meta"
      }
    },
    "/api/v1/meta/path-rules": {
      "get": {
        "description": "The file and folder naming rules every client applies (storage contract \u00a73.2).",
        "operationId": "get_path_rules",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Get Path Rules",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Get Path Rules"
      }
    },
    "/healthz": {
      "get": {
        "description": "Whether the server process answers: always 200 `ok`; no dependency is checked.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Healthz"
      }
    },
    "/readyz": {
      "get": {
        "description": "Whether the server can take traffic: 200 `ok`, or 503 `fail` when a dependency is down.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Readyz"
      }
    }
  }
}
