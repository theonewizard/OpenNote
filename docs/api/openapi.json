{
  "components": {
    "schemas": {
      "ProbeStatus": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "fail"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "ProbeStatus",
        "type": "object"
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "properties": {
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ServerMeta": {
        "properties": {
          "api_versions": {
            "items": {
              "type": "string"
            },
            "title": "Api Versions",
            "type": "array"
          },
          "login_methods": {
            "items": {
              "type": "string"
            },
            "title": "Login Methods",
            "type": "array"
          },
          "server_version": {
            "title": "Server Version",
            "type": "string"
          },
          "sync_protocol_versions": {
            "items": {
              "type": "integer"
            },
            "title": "Sync Protocol Versions",
            "type": "array"
          }
        },
        "required": [
          "server_version",
          "api_versions",
          "sync_protocol_versions",
          "login_methods"
        ],
        "title": "ServerMeta",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "OpenNote API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/meta": {
      "get": {
        "operationId": "get_meta",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerMeta"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Get Meta"
      }
    },
    "/healthz": {
      "get": {
        "operationId": "healthz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Healthz"
      }
    },
    "/readyz": {
      "get": {
        "description": "Ready when PostgreSQL and Valkey answer and both data directories are writable.\n\nThe checks run concurrently, each under its own timeout, so the probe answers in\nabout one timeout even when a host is unreachable. The route is keyless, so probes\nthat arrive while checks are running share them instead of opening more connections;\na finished run is never reused, so there is no cached result.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProbeStatus"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            },
            "description": "Problem details (RFC 9457)"
          }
        },
        "summary": "Readyz"
      }
    }
  }
}
