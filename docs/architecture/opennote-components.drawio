<mxfile host="app.diagrams.net" type="device"><diagram id="tiers" name="Components by tier (as-is)"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1320" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;OpenNote components by tier (as built, main 2f14f9a, 2026-11-21)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Grey arrows: runtime calls and data flow. Red dashed: dependencies that cross a tier boundary the wrong way (V-numbers match docs/architecture/tier-split-actions.md).&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=17;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="46" as="geometry"/></mxCell><mxCell id="fe" value="FRONTEND  (clients; talk to the backend only through /api/v1, contract docs/api/openapi.json)" style="swimlane;startSize=28;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingLeft=10;container=1;collapsible=0;swimlaneFillColor=#dae8fc;" vertex="1" parent="1"><mxGeometry x="20" y="70" width="1660" height="250" as="geometry"/></mxCell><mxCell id="spa" value="&lt;b&gt;Web client  (web/)&lt;/b&gt;&lt;br&gt;React · Vite · TypeScript · Tailwind/shadcn&lt;br&gt;• app shell + NoteEditor feature&lt;br&gt;• CodeMirror 6 Markdown editor&lt;br&gt;• sync engine: IndexedDB offline cache,&lt;br&gt;  push/changes, EventSource /api/v1/events&lt;br&gt;• generated OpenAPI client + Zod checks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="20" y="40" width="330" height="190" as="geometry"/></mxCell><mxCell id="apple" value="Apple clients  (apple/)  SwiftUI, macOS + iOS/iPadOS" style="swimlane;startSize=28;rounded=1;arcSize=2;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingLeft=10;container=1;collapsible=0;swimlaneFillColor=#dae8fc;" vertex="1" parent="fe"><mxGeometry x="370" y="40" width="640" height="190" as="geometry"/></mxCell><mxCell id="apps" value="&lt;b&gt;Apps/macOS, Apps/iOS&lt;/b&gt;&lt;br&gt;Shared RootView&lt;br&gt;(thin app targets)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="apple"><mxGeometry x="15" y="35" width="150" height="140" as="geometry"/></mxCell><mxCell id="pedit" value="&lt;b&gt;OpenNoteEditor&lt;/b&gt;&lt;br&gt;TextKit Markdown editor + styler" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="apple"><mxGeometry x="175" y="35" width="145" height="65" as="geometry"/></mxCell><mxCell id="pcore" value="&lt;b&gt;OpenNoteCore&lt;/b&gt;&lt;br&gt;frontmatter, links, paths&lt;br&gt;(parity with backend)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="apple"><mxGeometry x="175" y="110" width="145" height="65" as="geometry"/></mxCell><mxCell id="pstore" value="&lt;b&gt;OpenNoteStorage&lt;/b&gt;&lt;br&gt;local vault (POSIX, atomic swap) + SQLite state" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="apple"><mxGeometry x="330" y="35" width="150" height="140" as="geometry"/></mxCell><mxCell id="psync" value="&lt;b&gt;OpenNoteSync&lt;/b&gt;&lt;br&gt;sync engine,&lt;br&gt;SyncAPI protocol" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="apple"><mxGeometry x="490" y="35" width="135" height="65" as="geometry"/></mxCell><mxCell id="papi" value="&lt;b&gt;OpenNoteAPI&lt;/b&gt;&lt;br&gt;generated Swift&lt;br&gt;OpenAPI client" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="apple"><mxGeometry x="490" y="110" width="135" height="65" as="geometry"/></mxCell><mxCell id="clip" value="&lt;b&gt;Web Clipper  (clipper/)&lt;/b&gt;&lt;br&gt;Manifest V3 extension,&lt;br&gt;no build step.&lt;br&gt;POST /api/v1/clips with a&lt;br&gt;vault-scoped PAT" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="fe"><mxGeometry x="1030" y="40" width="250" height="190" as="geometry"/></mxCell><mxCell id="obs" value="&lt;b&gt;Obsidian / any editor&lt;/b&gt;&lt;br&gt;(external actor)&lt;br&gt;edits the Markdown vault&lt;br&gt;directly on disk; the&lt;br&gt;watcher picks it up" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;dashed=1;" vertex="1" parent="fe"><mxGeometry x="1300" y="40" width="340" height="190" as="geometry"/></mxCell><mxCell id="mw" value="MIDDLEWARE  (edge, identity, transport, messaging, process runtimes)" style="swimlane;startSize=28;rounded=1;arcSize=2;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingLeft=10;container=1;collapsible=0;swimlaneFillColor=#ffe6cc;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1660" height="300" as="geometry"/></mxCell><mxCell id="nginx" value="&lt;b&gt;opennote-web  (nginx, UBI 10)&lt;/b&gt;&lt;br&gt;serves the SPA bundle&lt;br&gt;reverse proxy /api/, /healthz, /readyz&lt;br&gt;security headers, body/header limits,&lt;br&gt;Problem Details for proxy errors&lt;br&gt;fronted by Ingress / OpenShift Route" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="mw"><mxGeometry x="20" y="40" width="270" height="240" as="geometry"/></mxCell><mxCell id="api" value="&lt;b&gt;opennote-api  (uvicorn, app.api)&lt;/b&gt;&lt;br&gt;routers /api/v1: vaults, folders, notes, attachments, sync,&lt;br&gt;search, tasks, calendar, clips, imports, users, meta, health&lt;br&gt;• deny-by-default auth (assert_routes_authenticated)&lt;br&gt;• rate limits, RFC 9457 problems, ETag/If-Match,&lt;br&gt;  idempotency replay, cursors (conventions.py)&lt;br&gt;• SSE /api/v1/events (Valkey subscriber)&lt;br&gt;• deps.py: Committers + commit() + AI/OCR enqueue&lt;br&gt;&lt;br&gt;V1: routers also hold domain logic and SQL&lt;br&gt;(notes.py 882 lines, folders.py does vault fd I/O,&lt;br&gt;attachments.py sniffing/streaming)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="mw"><mxGeometry x="310" y="40" width="470" height="240" as="geometry"/></mxCell><mxCell id="auth" value="&lt;b&gt;app.auth&lt;/b&gt;&lt;br&gt;OIDC login (OPENNOTE_OIDC_PROVIDERS)&lt;br&gt;OAuth2 + PKCE for Apple/CLI&lt;br&gt;personal access tokens&lt;br&gt;web session cookie + CSRF&lt;br&gt;signing keys in PostgreSQL&lt;br&gt;admin CLI&lt;br&gt;external OIDC IdP (state band)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="mw"><mxGeometry x="800" y="40" width="240" height="240" as="geometry"/></mxCell><mxCell id="valkey" value="&lt;b&gt;opennote-valkey  (Valkey, UBI 10)&lt;/b&gt;&lt;br&gt;• Dramatiq broker (job queues)&lt;br&gt;• pub/sub opennote:changes:&amp;lt;vault&amp;gt;&lt;br&gt;  (sync change hints)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="mw"><mxGeometry x="1060" y="40" width="250" height="240" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b&gt;worker&lt;/b&gt;&lt;br&gt;python -m app.workers&lt;br&gt;Dramatiq runtime,&lt;br&gt;1 proc x 4 threads,&lt;br&gt;loads app.ai.jobs and&lt;br&gt;app.ocr.jobs,&lt;br&gt;at-least-once,&lt;br&gt;50 s shutdown" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="mw"><mxGeometry x="1330" y="40" width="150" height="240" as="geometry"/></mxCell><mxCell id="watcher" value="&lt;b&gt;watcher&lt;/b&gt;&lt;br&gt;python -m app.vaults&lt;br&gt;watchdog ingest of&lt;br&gt;on-disk edits, daily&lt;br&gt;retention/GC,&lt;br&gt;one instance&lt;br&gt;(PostgreSQL&lt;br&gt;advisory lock)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="mw"><mxGeometry x="1490" y="40" width="150" height="240" as="geometry"/></mxCell><mxCell id="be" value="BACKEND  (domain modules and state)" style="swimlane;startSize=28;rounded=1;arcSize=2;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingLeft=10;container=1;collapsible=0;swimlaneFillColor=#d5e8d4;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="1660" height="520" as="geometry"/></mxCell><mxCell id="dom" value="Domain modules  (backend/app, one image opennote-api, modular monolith ADR-0003)" style="swimlane;startSize=28;rounded=1;arcSize=2;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingLeft=10;container=1;collapsible=0;swimlaneFillColor=#d5e8d4;" vertex="1" parent="be"><mxGeometry x="20" y="38" width="1620" height="268" as="geometry"/></mxCell><mxCell id="sync" value="&lt;b&gt;app.sync&lt;/b&gt;&lt;br&gt;Committer (ordered save steps,&lt;br&gt;per-vault lock), 3-way merge,&lt;br&gt;history store, changes/snapshot,&lt;br&gt;retention, change publisher" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="15" y="37" width="254" height="105" as="geometry"/></mxCell><mxCell id="vaults" value="&lt;b&gt;app.vaults&lt;/b&gt;&lt;br&gt;registry, config, safe paths,&lt;br&gt;fd-relative fsio, scan,&lt;br&gt;watchdog VaultWatcher" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="283" y="37" width="254" height="105" as="geometry"/></mxCell><mxCell id="notes" value="&lt;b&gt;app.notes&lt;/b&gt;&lt;br&gt;parse, frontmatter, identity,&lt;br&gt;links/graph, rename, templates,&lt;br&gt;derived index (tags, links, FTS)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="551" y="37" width="254" height="105" as="geometry"/></mxCell><mxCell id="search" value="&lt;b&gt;app.search&lt;/b&gt;&lt;br&gt;query grammar,&lt;br&gt;PostgreSQL full-text&lt;br&gt;(notes + OCR text)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="819" y="37" width="254" height="105" as="geometry"/></mxCell><mxCell id="tasks" value="&lt;b&gt;app.tasks&lt;/b&gt;&lt;br&gt;task parsing,&lt;br&gt;recurrence" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="1087" y="37" width="254" height="105" as="geometry"/></mxCell><mxCell id="calendar" value="&lt;b&gt;app.calendar&lt;/b&gt;&lt;br&gt;ICS feed from tasks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="1355" y="37" width="254" height="105" as="geometry"/></mxCell><mxCell id="attach" value="&lt;b&gt;app.attachments&lt;/b&gt;&lt;br&gt;EMPTY package: logic lives&lt;br&gt;in app/api/attachments.py" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="15" y="154" width="254" height="100" as="geometry"/></mxCell><mxCell id="imports" value="&lt;b&gt;app.imports&lt;/b&gt;&lt;br&gt;ENEX import,&lt;br&gt;HTML to Markdown (clips)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="283" y="154" width="254" height="100" as="geometry"/></mxCell><mxCell id="ocr" value="&lt;b&gt;app.ocr&lt;/b&gt;&lt;br&gt;Tesseract extraction,&lt;br&gt;vault OCR pass, ocr_vault_job" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="551" y="154" width="254" height="100" as="geometry"/></mxCell><mxCell id="ai" value="&lt;b&gt;app.ai&lt;/b&gt;&lt;br&gt;providers (Ollama, OpenAI-compat),&lt;br&gt;pgvector embeddings, embed job,&lt;br&gt;Claude read/suggest agent (CLI)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="819" y="154" width="254" height="100" as="geometry"/></mxCell><mxCell id="core" value="&lt;b&gt;app.core&lt;/b&gt;&lt;br&gt;settings, DB engines, logging,&lt;br&gt;RFC 9457 problems, audit log" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="dom"><mxGeometry x="1087" y="154" width="522" height="100" as="geometry"/></mxCell><mxCell id="state" value="State and external services" style="swimlane;startSize=28;rounded=1;arcSize=2;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=15;align=left;verticalAlign=top;spacingLeft=10;container=1;collapsible=0;swimlaneFillColor=#f5f5f5;" vertex="1" parent="be"><mxGeometry x="20" y="320" width="1620" height="175" as="geometry"/></mxCell><mxCell id="pg" value="&lt;b&gt;opennote-postgres&lt;/b&gt;&lt;br&gt;PostgreSQL 18 + pgvector (UBI 10)&lt;br&gt;files, revisions, change log,&lt;br&gt;users/tokens, index, embeddings" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="state"><mxGeometry x="15" y="38" width="214" height="122" as="geometry"/></mxCell><mxCell id="vfs" value="&lt;b&gt;Vault filesystem  (PVC)&lt;/b&gt;&lt;br&gt;Markdown + attachments,&lt;br&gt;AUTHORITATIVE source&lt;br&gt;(Obsidian-compatible)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="state"><mxGeometry x="244" y="38" width="214" height="122" as="geometry"/></mxCell><mxCell id="hist" value="&lt;b&gt;History store  (PVC)&lt;/b&gt;&lt;br&gt;content-addressed blobs&lt;br&gt;outside the DB (ADR-0017)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="state"><mxGeometry x="473" y="38" width="214" height="122" as="geometry"/></mxCell><mxCell id="backup" value="&lt;b&gt;opennote-backup&lt;/b&gt;&lt;br&gt;CronJob / Compose service&lt;br&gt;pg_dump + vault + history,&lt;br&gt;shared advisory lock" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="state"><mxGeometry x="702" y="38" width="214" height="122" as="geometry"/></mxCell><mxCell id="idp" value="&lt;b&gt;OIDC identity provider&lt;/b&gt;&lt;br&gt;(external)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;dashed=1;" vertex="1" parent="state"><mxGeometry x="931" y="38" width="214" height="122" as="geometry"/></mxCell><mxCell id="aiprov" value="&lt;b&gt;AI providers (opt-in)&lt;/b&gt;&lt;br&gt;Ollama / llama.cpp / vLLM&lt;br&gt;Claude API (external)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;dashed=1;" vertex="1" parent="state"><mxGeometry x="1160" y="38" width="214" height="122" as="geometry"/></mxCell><mxCell id="tess" value="&lt;b&gt;Tesseract&lt;/b&gt;&lt;br&gt;(built from source into&lt;br&gt;the api image)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;dashed=1;" vertex="1" parent="state"><mxGeometry x="1389" y="38" width="214" height="122" as="geometry"/></mxCell><mxCell id="v" value="&lt;b&gt;Boundary findings not drawn as arrows&lt;/b&gt;&lt;br&gt;V6  modules read each other's tables (sync, search, ai, ocr import notes/vaults/ocr/sync models), against ADR-0003 'never through each other's tables'&lt;br&gt;V7  import cycles: vaults &amp;lt;-&amp;gt; sync, notes &amp;lt;-&amp;gt; tasks, core &amp;lt;-&amp;gt; auth&lt;br&gt;V8  derived index is written synchronously after each commit (Committer._index); ADR-0003 says the worker does it asynchronously.  ADR-0003 also names a separate 'ai' process/image that does not exist (AI jobs run in the worker)&lt;br&gt;V9  nothing enforces the boundaries (no import contract test in CI)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=4;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="1205" width="1660" height="95" as="geometry"/></mxCell><mxCell id="e1" value="REST + SSE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="spa" target="nginx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="REST, OAuth2 PKCE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;fontColor=#555555;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="apple" target="nginx"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="clips, PAT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=10;labelBack