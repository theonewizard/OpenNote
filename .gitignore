# Nothing generated, secret or machine-local is committed (CLAUDE.md §21).

# Secrets and local configuration
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.pyc
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/

# Coverage artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
coverage/

# Node / web
node_modules/
.vite/
dist/
*.tsbuildinfo
playwright-report/
test-results/

# Apple (the Xcode project is generated by XcodeGen)
apple/OpenNote.xcodeproj/
apple/.build/
**/.build/
.swiftpm/
DerivedData/
xcuserdata/

# Worktrees and agent scratch
.worktrees/
.claude/worktrees/
.superpowers/
.understand-anything/

# Temporary logs, downloads and dumps
*.log
*.tmp
*.dump
/tmp/

# IDE and OS state
.idea/
.vscode/
*.swp
*~
.DS_Store
