# opennote-postgres: PostgreSQL 18 with pgvector on UBI 9 minimal, from the PostgreSQL
# project's RPM repository (PGDG), which builds both for RHEL 9 (ADR-0010). The UBI
# repositories carry no PostgreSQL server.
#
# Build from the repository root:
#   docker build -f infrastructure/containers/postgres/Containerfile -t opennote-postgres:dev .
#
# Runs as UID 1001 group 0 or any other UID in group 0, on a read-only root filesystem with
# a writable /tmp and a volume at /var/lib/postgresql/data. First start: see entrypoint.sh.

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:c4c285d42941ebb2bd4da878479008e1e4536bb599aad1dbe568f89de9053661

LABEL org.opencontainers.image.title="opennote-postgres" \
      org.opencontainers.image.description="PostgreSQL 18 with pgvector for OpenNote" \
      org.opencontainers.image.source="https://github.com/theonewizard/OpenNote" \
      org.opencontainers.image.licenses="PostgreSQL"

# Packages are signature-checked against the PGDG key, fetched over HTTPS. $basearch is
# expanded by microdnf, not the shell.
# hadolint ignore=SC2016
RUN rpm --import https://download.postgresql.org/pub/repos/yum/keys/PGDG-RPM-GPG-KEY-RHEL \
    && printf '%s\n' '[pgdg18]' \
        'name=PostgreSQL 18 for RHEL 9 - $basearch' \
        'baseurl=https://download.postgresql.org/pub/repos/yum/18/redhat/rhel-9-$basearch' \
        'enabled=1' \
        'gpgcheck=1' \
        'gpgkey=https://download.postgresql.org/pub/repos/yum/keys/PGDG-RPM-GPG-KEY-RHEL' \
        > /etc/yum.repos.d/pgdg18.repo \
    && microdnf install -y --nodocs --setopt=install_weak_deps=0 \
        postgresql18-server-18.6 postgresql18-contrib-18.6 pgvector_18-0.8.7 \
    && microdnf clean all

COPY infrastructure/containers/postgres/entrypoint.sh /usr/local/bin/entrypoint.sh

# initdb needs a passwd entry for the UID it runs as, which may be any UID. The root
# filesystem is read-only, so /etc/passwd points to /tmp/passwd, which entrypoint.sh writes
# from this copy plus the current UID. The data volume is owned by group 0 so any UID in
# group 0 can create the cluster directory in it. This step goes last: after it, user
# lookups in the image fail until the entrypoint has run.
RUN mkdir -p /var/lib/postgresql/data \
    && chown -R 1001:0 /var/lib/postgresql \
    && chmod -R 0770 /var/lib/postgresql \
    && cp /etc/passwd /etc/passwd.image \
    && ln -sf /tmp/passwd /etc/passwd

ENV PATH=/usr/pgsql-18/bin:$PATH \
    PGDATA=/var/lib/postgresql/data/pgdata

USER 1001:0
EXPOSE 5432

# SIGINT is PostgreSQL's fast shutdown; SIGTERM would wait for every client to disconnect.
STOPSIGNAL SIGINT
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
