# opennote-web: the built web app on nginx, which forwards /api/, /healthz and /readyz to
# the API at http://api:8000, or at OPENNOTE_API_UPSTREAM (host[:port]); see
# infrastructure/containers/web/entrypoint.sh and nginx.conf.
#
# Build from the repository root:
#   docker build -f infrastructure/containers/web/Containerfile -t opennote-web:dev .
#
# The builder is the official Node.js image at the LTS release in .nvmrc; only its output,
# static files, reaches the runtime image, which is UBI 9 minimal with nginx 1.26 from the
# UBI repositories. Runs as UID 1001 group 0 or any other UID in group 0, on a read-only
# root filesystem with a writable /tmp.

FROM docker.io/library/node:24.22.0-trixie-slim@sha256:7f486cabe892bff8fef04c0f7da8dba84a560be3e4e2740b7a86afc57ebec315 AS builder

WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

# Only the build inputs (the build type-checks src and tests), so a host's node_modules or
# dist never enters the image.
COPY web/index.html web/vite.config.ts web/playwright.config.ts \
     web/tsconfig.json web/tsconfig.app.json web/tsconfig.node.json ./
COPY web/src ./src
COPY web/tests ./tests
RUN npm run build

FROM registry.access.redhat.com/ubi9/ubi-minimal:9.8@sha256:c4c285d42941ebb2bd4da878479008e1e4536bb599aad1dbe568f89de9053661

LABEL org.opencontainers.image.title="opennote-web" \
      org.opencontainers.image.description="OpenNote web app served by nginx" \
      org.opencontainers.image.source="https://github.com/theonewizard/OpenNote" \
      org.opencontainers.image.licenses="AGPL-3.0-only"

# The nginx 1.26 module stream of the UBI 9 repositories, not version-pinned: it takes the
# 9.8 stream's security updates on top of the base image, which is pinned by digest.
# hadolint ignore=DL3041
RUN microdnf -y module enable nginx:1.26 \
    && microdnf install -y --nodocs --setopt=install_weak_deps=0 nginx-core \
    && microdnf clean all

COPY infrastructure/containers/web/nginx.conf /etc/nginx/nginx.conf
COPY infrastructure/containers/web/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --from=builder /web/dist /usr/share/opennote/web

USER 1001:0
EXPOSE 8080

# SIGQUIT is nginx's graceful shutdown (SIGTERM is its fast one). The entrypoint writes
# nginx's runtime settings to /tmp, then execs nginx, so nginx is PID 1 and receives it.
STOPSIGNAL SIGQUIT
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
