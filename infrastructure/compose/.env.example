# Settings for the full stack in compose.yaml (make up). Copy this file to .env next to it
# and replace the placeholders:
#
#   cp infrastructure/compose/.env.example infrastructure/compose/.env
#
# .env is git-ignored and must never be committed. "opennote" as user and password below
# is a throwaway development placeholder, not a secret: change it before the stack holds
# real notes.
#
# Secrets from files: when OPENNOTE_DATABASE_URL or OPENNOTE_VALKEY_URL is unset or empty,
# the backend reads it from the file named by OPENNOTE_DATABASE_URL_FILE or
# OPENNOTE_VALKEY_URL_FILE instead (at most 64 KiB, one trailing newline removed).
# POSTGRES_PASSWORD_FILE works the same way for POSTGRES_PASSWORD. The file must be
# mounted into the container, for example as a Compose secret.

# --- Database server (postgres service); read on its first start only ---
# Superuser created at the first start; owns the application database.
POSTGRES_USER=opennote
POSTGRES_PASSWORD=opennote
# POSTGRES_PASSWORD_FILE=/run/secrets/postgres_password
# Application database, created with the vector and pg_trgm extensions.
POSTGRES_DB=opennote
# Optional second database with the same extensions (the dev stack creates opennote_test).
# POSTGRES_TEST_DB=

# --- API and worker (api and worker services) ---
# SQLAlchemy URL for psycopg 3. User, password and database must match the values above.
OPENNOTE_DATABASE_URL=postgresql+psycopg://opennote:opennote@postgres:5432/opennote
# OPENNOTE_DATABASE_URL_FILE=/run/secrets/database_url
# Valkey speaks the Redis protocol, hence redis://.
OPENNOTE_VALKEY_URL=redis://valkey:6379/0
# OPENNOTE_VALKEY_URL_FILE=/run/secrets/valkey_url
# development, test or production.
OPENNOTE_ENVIRONMENT=production
# A Python log level name; INFO when unset.
OPENNOTE_LOG_LEVEL=INFO
# true: the API container runs `alembic upgrade head` before it starts. false (the
# default): migrations are applied deliberately. Use true with one API instance only.
OPENNOTE_MIGRATE_ON_START=false
# OPENNOTE_VAULT_ROOT and OPENNOTE_HISTORY_ROOT are set in compose.yaml to the mount points
# of the vaults and history volumes (/var/lib/opennote/vaults and
# /var/lib/opennote/history); do not set them here.
